# --- Database ---------------------------------------------------------
DATABASE_URL=postgres://passage:passage@localhost:5432/passage

# --- Server ----------------------------------------------------------------
PORT=3000

# --- Auth ------------------------------------------------------------------
SESSION_SECRET=

# --- App -----------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Storage -----------------------------------------------------------
# Local filesystem path where uploaded source documents are stored before
# ingestion (extraction + chunking). See src/lib/storage.ts.
UPLOADS_DIR=./uploads

# --- Slack (optional) ------------------------------------------------------
# Only needed to verify inbound Slack requests are actually from Slack -
# see src/lib/slack/verify.ts. Leave unset in dev; the Slack routes are
# unreachable without it anyway.
SLACK_SIGNING_SECRET=
